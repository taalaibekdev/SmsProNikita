<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmsProNikita</RootNamespace>
    <AssemblyName>SmsProNikita</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet metadata -->
    <PackageId>SmsProNikita</PackageId>
    <Version>1.0.1</Version>
    <Authors>taalaibekdev</Authors>
    <Description>DI-клиент для XML-протокола SMS-шлюза smspro.nikita.kg (отправка SMS, отчёты о доставке, инфо об абоненте, баланс счёта).</Description>
    <PackageTags>sms;smspro;nikita;kyrgyzstan;gateway;xml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/taalaibekdev/SmsProNikita</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taalaibekdev/SmsProNikita</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink: отладочные символы указывают на исходники в GitHub. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmsProNikita.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
